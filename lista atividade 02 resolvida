int main() {
    int a, b, c, maiorAB, maior;

    printf("Digite tres valores: ");
    scanf("%d %d %d", &a, &b, &c);

    maiorAB = (a + b + abs(a - b)) / 2;

    maior = (maiorAB + c + abs(maiorAB - c)) / 2;

    printf("O maior eh %d", maior);

    return 0;
}




