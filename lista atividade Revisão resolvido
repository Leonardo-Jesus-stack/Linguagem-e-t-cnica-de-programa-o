#include <stdio.h>
#include <stdlib.h>


int main(int argc, char *argv[]){
	
	float temperatura, celsius, fah;
	char escala;
	
	printf("Digite a escala da temperatura  (C para Celsius, F para Fahrenheit):");
	scanf(" %c", &escala);
	
	printf("Digite o valor da temperatura:");
	scanf("%f", &temperatura);
	
	celsius = (temperatura * 9.0/5.0) + 32;
	fah = (temperatura - 32) * 5.0/9.0;
	
	if (escala == 'C' || escala == 'c'){
		printf("\n%.2f C equivale a %.2f F\n", temperatura, celsius);
	}
	else if (escala == 'F' || escala == 'f'){
		printf("\n%.2f F equivale a %.2f C\n", temperatura, fah);
	}
	
	else {
		printf ("Escala invalida! escolha apenas C ou F");
	}
	
	 return 0;
}


