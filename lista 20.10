#include <stdio.h>
#include <stdlib.h>
#include <locale.h>

int main() {
	setlocale(LC_ALL, "Portuguese");

	int numero[100], i;
	for(i=0; i<100; i++){
		printf("Digite o Número %d: ", i+1 );
		scanf("%d", &numero[i]);
	}
	for(i=99; i>=0; i--){
		printf("\nNumero %d: %d", i+1,numero[i]);
	}
	
	return 0;
}
