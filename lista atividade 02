#include <stdio.h>
#include <stdlib.h>


int main(int argc, char *argv[]) {
	int tempo, horas, minutos, seg;

    printf("Digite o tempo em segundos: ");
    scanf("%d", &tempo);

    horas = tempo / 3600;
    minutos = (tempo % 3600) / 60;
    seg = tempo % 60;

    printf("%d:%d:%d\n", horas, minutos, seg);

    return 0;
}


