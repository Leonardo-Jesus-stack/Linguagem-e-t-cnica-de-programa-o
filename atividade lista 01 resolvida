#include <stdio.h>
#include <stdlib.h>


int main(int argc, char *argv[]) {
	int dias, anos, meses, resto;
	
	printf ("Digite a idade em dias:");
	scanf("%d", &dias);
	
	anos = dias / 365;
	resto = dias % 365;
	
	meses = resto / 30;
	dias = resto % 30;
	
	printf("%d anos, %d meses, %d dias", anos, meses, dias);
	
	return 0;
}

